# 環境変数のサンプル（秘密情報は含めない。実際の値は環境ごとの .env.staging / .env.prod に置き、リポジトリに入れない）
# 生成例: openssl rand -hex 32

# prod（本番: 許諾確認・条件確定・動作確認の記録が公開の条件） / staging（確認用環境: さいしんの動作確認用。未確定のままでも動かせる、別DB） / dev（開発・検算: 127.0.0.1 限定）
APP_ENV=staging

# 運用担当（開催・公開・停止・削除）と確認担当（動作確認の記録のみ）。互いに異なる32文字以上の乱数
OPERATOR_TOKEN=
VERIFIER_TOKEN=

# 待受。コンテナでは 0.0.0.0、直接起動では 127.0.0.1（外部公開はリバースプロキシ経由のみ）
HOST=127.0.0.1
PORT=8080

# 永続データ（SQLite）。環境ごとに別ファイル・別ボリュームにすること
DB_PATH=/data/app.sqlite

# 前段のリバースプロキシが付ける X-Forwarded-For を信頼する（プロキシ配下でのみ 1）
TRUST_PROXY=1
# 参加操作のレート制限（送信元IPあたり/分）。会場Wi-FiのNATで全員が同じIPになる前提で余裕を持たせる
JOIN_RATE_PER_MIN=600

# 管理画面・管理APIを、このホスト上からの直接接続だけに限定する（1）。プロキシ／トンネル経由の要求には 404 を返す。
# 管理画面をプロキシのIP制限で公開する構成では 0 のままにする
ADMIN_LOCAL_ONLY=0

# 参加者が開く公開URL（https://ドメイン のみ。経路は付けない）。管理画面の参加用QRコードに使う。
# 未設定のときは管理画面を開いているURLで作る（管理画面を 127.0.0.1 で開く構成では必ず設定する）
PUBLIC_URL=

# 削除ジョブの間隔（ミリ秒）
PURGE_INTERVAL_MS=60000
