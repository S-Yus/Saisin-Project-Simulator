# nginx を使う場合の例（TLS 証明書は別途）。ドメイン・IP はプレースホルダ
log_format nisa_nopii '$time_iso8601 $request_method $uri $status $request_time';  # $uri はクエリを含まない。IP・ヘッダーは記録しない

server {
    listen 443 ssl http2;
    server_name staging.example.jp;
    ssl_certificate     /etc/ssl/nisa/fullchain.pem;
    ssl_certificate_key /etc/ssl/nisa/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;
    access_log /var/log/nginx/nisa-staging.log nisa_nopii;
    client_max_body_size 13m;

    location ~ ^/(admin|admin\.html|admin\.js|admin-api/) {
        allow 192.0.2.0/24;   # 管理を許可する拠点 / VPN
        deny all;
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header X-Forwarded-For $remote_addr;   # 末尾＝実接続元（TRUST_PROXY=1）
    }
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 30s;
    }
}
server { listen 80; server_name staging.example.jp; return 301 https://$host$request_uri; }
